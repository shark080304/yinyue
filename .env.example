# Copy this file to .env. Keep real API keys in .env only.
HOST=127.0.0.1
PORT=5173

# Optional shared recognition service. 0 disables the shared service.
AUDD_API_TOKEN=
SUNNY_AI_RECOGNITIONS_PER_DAY=0

# Optional shared complete vocal song generation. 0 disables the shared service.
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2_5
SUNNY_AI_MUSIC_MINUTES_PER_DAY=0

# Optional MiniMax account with existing Music API access.
MINIMAX_API_KEY=
MINIMAX_MUSIC_MODEL=music-3.0
MINIMAX_REGION=global
